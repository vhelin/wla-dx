;
; PC Engine / TurboGrafx-16 generic HuC6280 helper macros
;

.DEFINE PCE_MPR_MASK(slot) (1 << slot)

.MACRO PCE_DISABLE_INTERRUPTS
  sei
.ENDM

.MACRO PCE_ENABLE_INTERRUPTS
  cli
.ENDM

.MACRO PCE_CLEAR_DECIMAL
  cld
.ENDM

.MACRO PCE_MAP_IO_PAGE_TO_MPR0
  lda #PCE_IO_PAGE
  tam #1
.ENDM

.MACRO PCE_MAP_BANK_TO_MPR ARGS BANK, SLOT
  lda #BANK
  tam #PCE_MPR_MASK(SLOT)
.ENDM

.MACRO PCE_MAP_LABEL_TO_MPR ARGS LABEL, SLOT
  PCE_MAP_BANK_TO_MPR bank(LABEL), SLOT
.ENDM

.MACRO PCE_PUSH_MPR ARGS SLOT
  tma #PCE_MPR_MASK(SLOT)
  pha
.ENDM

.MACRO PCE_POP_MPR ARGS SLOT
  pla
  tam #PCE_MPR_MASK(SLOT)
.ENDM
